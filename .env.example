# ==========================================================
# Verve & Co. — Environment Configuration
# Razorpay AI Buildathon Track 01 (AI Growth & Agentic Commerce)
# ==========================================================

# 1. Razorpay Test-Mode Credentials (from Razorpay Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_yourKeyHere
RAZORPAY_KEY_SECRET=yourSecretHere
RAZORPAY_WEBHOOK_SECRET=yourWebhookSecretHere

# 2. Anthropic Claude API Key (Kept strictly server-side; NEVER exposed to browser)
# If left unset, server uses intelligent deterministic fallbacks for 100% demo uptime
ANTHROPIC_API_KEY=sk-ant-api03-yourKeyHere

# 3. ACP Adapter Security
# In production, bearer token authentication is required for /acp/* endpoints.
# For local dev / demo, defaults to 'verve_acp_demo_bearer_token' if not set.
ACP_API_TOKEN=verve_acp_demo_bearer_token

# 4. Server Port (for standalone Node execution)
PORT=4000
